{
  "name": "example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "dev:frontend": "vite --clearScreen false",
    "dev:backend": "convex dev",
    "codegen": "convex codegen --typecheck disable",
    "build": "tsc -b && vite build",
    "setup": "node --import tsx scripts/setup.ts",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report",
    "e2e:webhooks": "node --import tsx scripts/e2e-webhooks.ts",
    "typecheck": "tsc -b",
    "typecheck:convex": "npx convex dev --once",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fantastic.dev/better-stripe": "workspace:*",
    "@fontsource-variable/geist": "^5.3.0",
    "@stripe/react-stripe-js": "^6.12.0",
    "@stripe/stripe-js": "^9.17.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.46.0",
    "lucide-react": "^1.48.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "stripe": "~22.2.3",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^2.0.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.9.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "npm-run-all": "^4.1.5",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1"
  }
}
