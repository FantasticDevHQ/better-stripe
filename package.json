{
  "name": "@fantastic.dev/better-stripe",
  "version": "0.62.0",
  "description": "A Convex component for Stripe V2 Accounts API integration.",
  "keywords": [
    "stripe",
    "convex",
    "component"
  ],
  "homepage": "https://github.com/FantasticDevHQ/better-stripe#readme",
  "bugs": {
    "url": "https://github.com/FantasticDevHQ/better-stripe/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FantasticDevHQ/better-stripe.git"
  },
  "license": "MIT",
  "author": "Kelly Kampen",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./_generated/component": {
      "types": "./dist/component/_generated/component.d.ts",
      "default": "./dist/component/_generated/component.js"
    },
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts",
      "default": "./dist/component/_generated/component.js"
    },
    "./usage": {
      "types": "./dist/client/usage/index.d.ts",
      "default": "./dist/client/usage/index.js"
    }
  },
  "main": "./dist/client/index.js",
  "types": "./dist/client/index.d.ts",
  "directories": {
    "doc": "docs",
    "example": "example"
  },
  "files": [
    "dist",
    "src",
    "docs/react-workflows.md",
    "docs/settlement.md",
    "docs/affiliate-clawbacks.md",
    "docs/accounts-v2-preview.md",
    "docs/react-workflows-audit.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "docs/read-contracts.md",
    "docs/billing-history.md",
    "docs/subscription-payment-methods.md",
    "docs/invoice-payment-pages.md",
    "docs/checkout-session-pages.md",
    "docs/refund-context.md",
    "docs/refund-command-evidence.md",
    "docs/personal-account-mapping.md",
    "docs/financial-ownership.md",
    "docs/financial-observations.md",
    "docs/architecture/component-extraction.md",
    "docs/architecture/durable-execution.md",
    "docs/architecture/recovery-workflow.md",
    "docs/balance-funding-state.md",
    "docs/balance-funding-workflow.md",
    "docs/processing-cost-reconciliation.md",
    "docs/example-balance-funding-cutover.md",
    "docs/example-recovery-cutover.md",
    "docs/releasing.md",
    "docs/release-handoff.md",
    "docs/setup-intent-recovery.md",
    "docs/metered-usage.md",
    "docs/metering-setup.md",
    "docs/README.md",
    "docs/overview.md",
    "docs/client-api.md",
    "docs/webhooks.md",
    "docs/marketplace.md",
    "docs/react-api.md",
    "docs/testing.md",
    "docs/configuration.md",
    "docs/architecture.md",
    "docs/development.md",
    "docs/usage-ledger.md",
    "docs/usage-catalog.md",
    "docs/usage-delivery.md",
    "docs/usage-observations.md",
    "docs/usage-subscriptions.md",
    "docs/usage-credits.md",
    "docs/usage-limits.md",
    "docs/usage-corrections.md",
    "docs/usage-settlement.md",
    "docs/usage-security.md",
    "docs/usage-react.md",
    "docs/evidence/native-metering",
    "docs/usage-configuration.md",
    "docs/usage-example.md",
    "docs/payout-revision-migration.md"
  ],
  "scripts": {
    "build": "tsc --project ./tsconfig.build.json && node scripts/check-public-exports.mjs",
    "dev": "cd example && pnpm run dev",
    "clean": "rm -rf dist",
    "codegen": "pnpm run codegen:lib && pnpm run codegen:example",
    "codegen:lib": "cd example && convex codegen --component-dir ../src/component --typecheck disable",
    "codegen:example": "pnpm --filter ./example run codegen",
    "codegen:check": "node scripts/check-codegen-drift.mjs",
    "typecheck": "npm run typecheck:lib && npm run typecheck:example",
    "typecheck:lib": "tsc --noEmit",
    "typecheck:example": "pnpm --filter ./example run typecheck",
    "lint": "npm run lint:lib && npm run lint:example",
    "lint:lib": "eslint src/ --cache --cache-location node_modules/.cache/eslint/",
    "lint:example": "pnpm --filter ./example run lint",
    "build:clean": "rm -rf dist *.tsbuildinfo && npm run build",
    "format": "prettier --check --ignore-path ./.prettierignore \"**/*.{js,cjs,mjs,ts,tsx,md,json,sql}\"",
    "format:fix": "prettier --write --ignore-path ./.prettierignore \"**/*.{js,cjs,mjs,ts,tsx,md,json,sql}\"",
    "format:staged": "pretty-quick --staged",
    "format:changed": "pretty-quick",
    "format:branch": "pretty-quick --branch main",
    "prepublishOnly": "npm run clean && npm run build && npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:design-system": "eslint --config eslint.design-system.config.mjs . --max-warnings 0",
    "check:shadscan": "shadscan \"./example\" --json --fail-under 100 --no-roast --no-interactive",
    "check:all": "repo-gates check-all",
    "check:size": "repo-gates check-size",
    "check:debt": "repo-gates check-debt",
    "check:circular": "repo-gates check-circular",
    "check:secrets": "repo-gates check-secrets",
    "check:ci-parity": "repo-gates check-ci-parity",
    "check:coverage": "node scripts/check-coverage.mjs",
    "format:check": "pnpm run format",
    "check:agents": "repo-gates check-agents"
  },
  "dependencies": {
    "@convex-dev/workflow": "0.4.10",
    "@convex-dev/workpool": "0.4.14",
    "@stripe/connect-js": "^3.4.6",
    "@stripe/react-connect-js": "^3.4.4",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.0.0",
    "convex-helpers": "^0.1.128",
    "stripe": "~23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@fantastic.dev/repo-gates": "^0.4.0",
    "@shadcn/lint": "0.1.5",
    "@shadscan/cli": "0.7.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "^8.71.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "5.0.3",
    "convex": "^1.46.0",
    "convex-test": "0.0.60",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "pretty-quick": "^4.2.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "convex": "^1.46.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "module": "./dist/client/index.js",
  "packageManager": "pnpm@10.32.1"
}
