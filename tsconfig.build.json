{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/component/_generated",
    "src/test.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/client/billing/renewalAttach/internal/test-fixtures/**",
    "src/component/balanceFunding/workflow.fixtures.ts",
    "src/component/renewalOperations/acknowledgement.fixtures.ts",
    "src/component/renewalOperations/configureJournal.fixtures.ts",
    "src/component/renewalOperations/timingPolicy.fixtures.ts",
    "src/testing/crossDomain/**"
  ]
}
