# Convex deployment (printed by `npx convex dev`)
VITE_CONVEX_URL=

# Convex HTTP actions URL — https://<deployment>.convex.site
VITE_CONVEX_SITE_URL=

# Stripe secret key (test mode) — sk_test_...
# `pnpm run setup` copies it into the Convex deployment environment.
STRIPE_SECRET_KEY=

# Stripe publishable key (test mode) — pk_test_...
# Not a Vite variable: the browser reads it through Convex
# (`stripe/public/queries:getPublishableKey`). `pnpm run setup` copies it into
# the Convex deployment environment as STRIPE_PUBLISHABLE_KEY.
STRIPE_PUBLISHABLE_KEY=
