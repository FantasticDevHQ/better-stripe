{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/component/_generated",
    "src/test.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.test.js",
    "src/**/*.fixture.ts",
    "src/**/*.fixtures.ts",
    "src/**/*TestHelpers.ts",
    "src/**/test-fixtures/**",
    "src/testing/component-db.ts",
    "src/testing/crossDomain/**"
  ]
}
