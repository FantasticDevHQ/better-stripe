{
  "name": "@getdojo/better-stripe",
  "version": "0.1.0",
  "description": "A Convex component for Stripe V2 Accounts API integration.",
  "keywords": [
    "stripe",
    "convex",
    "component"
  ],
  "homepage": "https://github.com/kellykampen/better-stripe#readme",
  "bugs": {
    "url": "https://github.com/kellykampen/better-stripe/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kellykampen/better-stripe.git"
  },
  "license": "MIT",
  "author": "Kelly Kampen",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    }
  },
  "main": "index.js",
  "types": "./dist/client/index.d.ts",
  "directories": {
    "doc": "docs",
    "example": "example"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --project ./tsconfig.build.json",
    "dev": "cd example && pnpm run dev",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --cache --cache-location node_modules/.cache/eslint/",
    "build:clean": "rm -rf dist *.tsbuildinfo && npm run build",
    "format": "prettier --check --ignore-path ./.prettierignore \"**/*.{js,cjs,mjs,ts,tsx,md,json,sql}\"",
    "format:fix": "prettier --write --ignore-path ./.prettierignore \"**/*.{js,cjs,mjs,ts,tsx,md,json,sql}\"",
    "format:staged": "pretty-quick --staged",
    "format:changed": "pretty-quick",
    "format:branch": "pretty-quick --branch main",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^5.6.1",
    "@stripe/stripe-js": "^8.11.0",
    "stripe": "^22.0.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/parser": "^8.58.0",
    "convex": "^1.34.1",
    "convex-test": "^0.0.46",
    "eslint": "^9.39.4",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "pretty-quick": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "convex": "^1.29.3",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "engines": {
    "node": ">=v18.18.0"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "module": "./dist/client/index.js",
  "packageManager": "pnpm@10.32.1"
}
