{
  "name": "@fantastic.dev/better-stripe",
  "version": "0.4.0",
  "description": "A Convex component for Stripe V2 Accounts API integration.",
  "keywords": [
    "stripe",
    "convex",
    "component"
  ],
  "homepage": "https://github.com/FantasticDevHQ/better-stripe#readme",
  "bugs": {
    "url": "https://github.com/FantasticDevHQ/better-stripe/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FantasticDevHQ/better-stripe.git"
  },
  "license": "MIT",
  "author": "Kelly Kampen",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./_generated/component": {
      "types": "./dist/component/_generated/component.d.ts",
      "default": "./dist/component/_generated/component.js"
    },
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts",
      "default": "./dist/component/_generated/component.js"
    }
  },
  "main": "./dist/client/index.js",
  "types": "./dist/client/index.d.ts",
  "directories": {
    "doc": "docs",
    "example": "example"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --project ./tsconfig.build.json",
    "dev": "cd example && pnpm run dev",
    "clean": "rm -rf dist",
    "codegen": "pnpm run codegen:lib && pnpm run codegen:example",
    "codegen:lib": "convex codegen --component-dir src/component --typecheck disable",
    "codegen:example": "pnpm --filter ./example run codegen",
    "codegen:check": "node scripts/check-codegen-drift.mjs",
    "typecheck": "npm run typecheck:lib && npm run typecheck:example",
    "typecheck:lib": "tsc --noEmit",
    "typecheck:example": "pnpm --filter ./example run typecheck",
    "lint": "npm run lint:lib && npm run lint:example",
    "lint:lib": "eslint src/ --cache --cache-location node_modules/.cache/eslint/",
    "lint:example": "pnpm --filter ./example run lint",
    "build:clean": "rm -rf dist *.tsbuildinfo && npm run build",
    "format": "prettier --check --ignore-path ./.prettierignore \"**/*.{js,cjs,mjs,ts,tsx,md,json,sql}\"",
    "format:fix": "prettier --write --ignore-path ./.prettierignore \"**/*.{js,cjs,mjs,ts,tsx,md,json,sql}\"",
    "format:staged": "pretty-quick --staged",
    "format:changed": "pretty-quick",
    "format:branch": "pretty-quick --branch main",
    "prepublishOnly": "npm run clean && npm run build && npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@stripe/connect-js": "^3.4.6",
    "@stripe/react-connect-js": "^3.4.4",
    "@stripe/react-stripe-js": "^6.12.0",
    "@stripe/stripe-js": "^9.17.0",
    "stripe": "~22.2.3"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^2.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "5.0.2",
    "convex": "^1.46.0",
    "convex-test": "0.0.53",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "pretty-quick": "^4.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "convex": "^1.29.3",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "engines": {
    "node": ">=v18.18.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "module": "./dist/client/index.js",
  "packageManager": "pnpm@10.32.1"
}
